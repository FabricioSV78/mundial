  qualification?: string;
};

type BracketMatch = {
  id: string;
  matchNo: number;
  round: string;
  home: string;
  away: string;
  locked?: boolean;
  tone?: "gold" | "green" | "blue" | "slate";
};

type BracketSide = {
  r32: BracketMatch[];
  r16: BracketMatch[];
  qf: BracketMatch[];
  sf: BracketMatch[];
};

type BracketTree = {
  left: BracketSide;
  right: BracketSide;
  final: BracketMatch;
  thirdPlace: BracketMatch;
};

const boardWidth = 1500;
const boardHeight = 1120;
const cardWidth = 150;
const cardHeight = 92;
const finalWidth = 180;
