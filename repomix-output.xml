      id: `${groupName}-${teamIndex + 1}`,
      name: `${groupName} Team ${teamIndex + 1}`,
      groupName,
    }));

    return {
      groupName,
      teams,
      matches: buildRoundRobinMatches(groupName, teams),
    };
  });

  const report = validateGroupStageCompletenessFromSeededGroups(groups, tournamentConfig);

