            user: {
              select: {
                id: true,
                email: true,
                username: true,
                name: true,
                avatar: true,
                favoriteCountry: true,
                role: true,
                createdAt: true,
              },
            },
          },
        },
      },
    });

    return NextResponse.json({
      ok: true,
      message: "Liga creada. Ya puedes invitar a tu grupo.",
